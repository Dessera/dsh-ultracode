{
    "name": "@dessera/dsh-ultracode",
    "version": "0.1.1",
    "description": "Ultracode session mode for DeepSeek Harness: a three-position composer control that arms automatic multi-agent workflow orchestration by injecting an arming banner ahead of the user's own message.",
    "author": "Dessera <dessera@qq.com> (https://github.com/Dessera)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Dessera/dsh-ultracode.git"
    },
    "homepage": "https://github.com/Dessera/dsh-ultracode#readme",
    "bugs": "https://github.com/Dessera/dsh-ultracode/issues",
    "type": "module",
    "engines": {
        "node": "^22.19.0 || >=24.0.0"
    },
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "default": "./lib/index.js"
        },
        "./client": "./lib/client.js",
        "./cordis.patch.yml": "./cordis.patch.yml",
        "./package.json": "./package.json"
    },
    "files": [
        "docs",
        "lib",
        "cordis.patch.yml"
    ],
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        },
        "client": {
            "platform": "web",
            "inject": [
                "@deepseek-ai/dsh-client-ui-conversation",
                "@deepseek-ai/dsh-client-locale"
            ]
        }
    },
    "scripts": {
        "build": "tsdown",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "node --test \"test/*.test.mjs\"",
        "compat": "node scripts/compat.mjs",
        "clean": "rm -rf lib",
        "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test",
        "prepare": "tsdown",
        "prepublishOnly": "pnpm check"
    },
    "keywords": [
        "deepseek-harness",
        "dsh",
        "cordis",
        "plugin",
        "ultracode",
        "workflow"
    ],
    "publishConfig": {
        "access": "public"
    },
    "license": "MIT",
    "peerDependencies": {
        "@deepseek-ai/dsh": ">=0.1.5-rc.3 <0.1.6-0 || >=0.1.6-alpha.1 <0.1.7-0 || >=0.1.7-rc.2 <0.1.8-0"
    },
    "devDependencies": {
        "@deepseek-ai/cordis": "4.0.2",
        "@deepseek-ai/dsh-agent": "0.1.5-rc.3",
        "@deepseek-ai/dsh-api-gateway": "0.1.5-rc.3",
        "@deepseek-ai/dsh-api-remotes": "0.1.5-rc.3",
        "@deepseek-ai/dsh-api-session-controller": "0.1.5-rc.3",
        "@deepseek-ai/dsh-client-locale": "0.1.5-rc.3",
        "@deepseek-ai/dsh-client-ui-conversation": "0.1.5-rc.3",
        "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.3",
        "@deepseek-ai/dsh-client-ui-session": "0.1.5-rc.3",
        "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.3",
        "@deepseek-ai/dsh-commands": "0.1.5-rc.3",
        "@deepseek-ai/dsh-host-webserver": "0.1.5-rc.3",
        "@deepseek-ai/dsh-llm": "0.1.5-rc.3",
        "@deepseek-ai/dsh-session": "0.1.5-rc.3",
        "@deepseek-ai/dsh-session-projection": "0.1.5-rc.3",
        "@deepseek-ai/dsh-tools": "0.1.5-rc.3",
        "@deepseek-ai/schemastery": "3.18.2",
        "@types/node": "^22.20.3",
        "@types/react": "^18.3.31",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.9.8",
        "semver": "^7.8.5",
        "tsdown": "^0.22.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.0"
    },
    "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
